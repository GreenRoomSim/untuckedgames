rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null && request.auth.uid == 'h6PSsO37hIUiMPnRxiaDmFrIlnf1'; }
    function st() { return get(/databases/$(database)/documents/state/current).data; }
    function me() { return get(/databases/$(database)/documents/voters/$(request.auth.uid)).data; }

    function validPlacements() {
      let d = request.resource.data; let q = st().quotas; let o = st().options;
      let all = d.win.concat(d.high).concat(d.low).concat(d.bottom);
      return d.win.size() == q.win && d.high.size() == q.high
        && d.low.size() == q.low && d.bottom.size() == q.bottom
        && all.toSet().hasOnly(o) && all.toSet().size() == all.size();
    }
    function validLipsync() {
      let c = request.resource.data.choices; let o = st().options;
      return (c.size() == 1 || (c.size() == 2 && o.size() >= 3))
        && c.toSet().hasOnly(o) && c.toSet().size() == c.size();
    }
    function validGroups() {
      let d = request.resource.data; let g = st().groups; let q = st().quotas;
      return d.group in ['a', 'b'] && d.win.size() == q.win && d.bottom.size() == q.bottom
        && d.win.toSet().size() == d.win.size() && d.bottom.toSet().size() == d.bottom.size()
        && (d.group == 'a'
          ? (d.win.toSet().hasOnly(g.a) && d.bottom.toSet().hasOnly(g.b))
          : (d.win.toSet().hasOnly(g.b) && d.bottom.toSet().hasOnly(g.a)));
    }
    function validRank() {
      let rk = request.resource.data.ranking; let o = st().options;
      return rk.size() == o.size() && rk.toSet().hasOnly(o) && rk.toSet().size() == rk.size();
    }
    function validWildcard() {
      let d = request.resource.data; let g = st().groups;
      return d.a in g.a && d.b in g.b;
    }
    function validChoice() {
      let c = request.resource.data.choice;
      return c in st().options;
    }

    match /contestants/{id} { allow read: if request.auth != null; allow write: if admin(); }
    match /voters/{id} {
      allow read: if admin() || (request.auth != null && request.auth.uid == id);
      allow write: if admin();
    }
    match /state/current { allow read: if request.auth != null; allow write: if admin(); }
    match /ballots/{id} {
      allow read: if admin() || (request.auth != null && id == 'r' + string(st().round) + '_' + request.auth.uid);
      allow create, update: if request.auth != null
        && id == 'r' + string(st().round) + '_' + request.auth.uid
        && st().open == true
        && me().get('canVote', true) == true
        && request.resource.data.round == st().round
        && request.resource.data.mode == st().mode
        && (st().mode == 'placements' ? validPlacements() : st().mode == 'lipsync' ? validLipsync() : st().mode == 'groups' ? validGroups() : st().mode == 'wildcard' ? validWildcard() : st().mode == 'rank' ? validRank() : validChoice());
    }
  }
}
