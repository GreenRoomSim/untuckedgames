rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null && request.auth.uid == 'h6PSsO37hIUiMPnRxiaDmFrIlnf1'; }
    function st() { return get(/databases/$(database)/documents/state/current).data; }
    function me() { return get(/databases/$(database)/documents/voters/$(request.auth.uid)).data; }

    function validPlacements() {
      let d = request.resource.data; let q = st().quotas; let o = st().options; let n = me().name;
      let all = d.win.concat(d.high).concat(d.low).concat(d.bottom);
      return d.win.size() == q.win && d.high.size() == q.high
        && d.low.size() == q.low && d.bottom.size() == q.bottom
        && all.toSet().hasOnly(o) && !(n in all) && all.toSet().size() == all.size();
    }
    function validChoice() {
      let c = request.resource.data.choice; let o = st().options; let n = me().name;
      return c in o && c != n && !(st().mode == 'lipsync' && n in o);
    }

    match /voters/{id} {
      allow read: if admin() || (request.auth != null && request.auth.uid == id);
      allow write: if admin();
    }
    match /state/current { allow read: if request.auth != null; allow write: if admin(); }
    match /ballots/{id} {
      allow read: if admin() || (request.auth != null && id == 'r' + string(st().round) + '_' + request.auth.uid);
      allow create, update: if request.auth != null
        && id == 'r' + string(st().round) + '_' + request.auth.uid
        && st().open == true
        && me().get('canVote', true) == true
        && request.resource.data.round == st().round
        && request.resource.data.mode == st().mode
        && (st().mode == 'placements' ? validPlacements() : validChoice());
    }
  }
}
